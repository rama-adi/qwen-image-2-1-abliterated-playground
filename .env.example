# RunPod template/Pod environment variables. These are examples, not credentials.
# Shared RunPod template default. Change before exposing your Pod.
# Generate a replacement with `openssl rand -hex 24`.
PLAYGROUND_PASSWORD=password
# Optional: read token from https://huggingface.co/settings/tokens
HF_TOKEN=
# Keep these defaults unless you want to skip rewriting/downloads.
PLAYGROUND_REWRITER=1
PLAYGROUND_DOWNLOAD_MODELS=1
PLAYGROUND_KV_CACHE=1
PLAYGROUND_REWRITE_TOKENS=6144

# Retain the RunPod pipeline after a successful render.
PLAYGROUND_KEEP_WARM=1
